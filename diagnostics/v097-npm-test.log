    fn return_to_dashboard(window: &WebviewWindow) {
        #[cfg(any(target_os = "android", target_os = "ios"))]
        {
            let state = window.app_handle().state::<AppState>();
            if let Ok(mut active) = state.mobile_refresh.lock() {
                *active = false;
